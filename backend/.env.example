# ============================================
# ApparelDesk Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# Django Core Settings
# ============================================
# Generate a secure secret key for production
# You can use: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
# In production, use your domain names
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# CORS Settings
# ============================================
# Comma-separated list of allowed origins for CORS
# Add your frontend URLs here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ============================================
# Database Settings (PostgreSQL)
# ============================================
DB_NAME=appareldesk_db
DB_USER=appareldesk_admin
DB_PASSWORD=admin@123
DB_HOST=localhost
DB_PORT=5432

# ============================================
# Razorpay Payment Gateway Configuration
# ============================================
# Get your credentials from: https://dashboard.razorpay.com/app/keys
# IMPORTANT: Use test mode credentials for development and testing
# Test mode allows you to test payments without real money using test cards and UPI

# Test Mode Credentials (for development)
RAZORPAY_API_KEY=rzp_test_RtqzLjqLxzOjqC
RAZORPAY_API_SECRET=FX5iZ97nhL6Mb5wcUZpyoZ8A
RAZORPAY_TEST_MODE=True

# Production Credentials (uncomment and use in production)
# RAZORPAY_API_KEY=rzp_live_your_live_key_here
# RAZORPAY_API_SECRET=your_live_secret_here
# RAZORPAY_TEST_MODE=False

# ============================================
# Additional Notes
# ============================================
# 1. JWT tokens are configured in settings.py:
#    - Access token lifetime: 60 minutes
#    - Refresh token lifetime: 7 days
#
# 2. Database must be PostgreSQL with UTF8 encoding
#
# 3. For production deployment:
#    - Set DEBUG=False
#    - Use a strong SECRET_KEY
#    - Configure proper ALLOWED_HOSTS
#    - Use production Razorpay credentials
#    - Enable HTTPS
#    - Configure proper database credentials
#
# 4. Test Cards for Razorpay Test Mode:
#    - Card Number: 4111 1111 1111 1111
#    - CVV: Any 3 digits
#    - Expiry: Any future date
#    - See more: https://razorpay.com/docs/payments/payments/test-card-details/
